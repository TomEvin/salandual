<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="LibGit2Sharp" />
    <PackageReference Include="LibGit2Sharp.NativeBinaries" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(PkgLibGit2Sharp_NativeBinaries)\libgit2\libgit2.license.txt" Link="licences\libgit2-License.txt" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Salandual.Core\Salandual.Core.csproj" />
    <InternalsVisibleTo Include="Salandual.Git.Tests" />
  </ItemGroup>
</Project>
