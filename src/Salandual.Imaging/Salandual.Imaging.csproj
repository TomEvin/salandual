<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-x64" />
    <PackageReference Include="BCnEncoder.Net" />
    <PackageReference Include="MetadataExtractor" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="MediaInfoDLL" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(PkgMediaInfoDLL)\lib\netstandard2.1\x64\MediaInfo.dll" Link="MediaInfo.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Salandual.Core\Salandual.Core.csproj" />
    <InternalsVisibleTo Include="Salandual.Imaging.Tests" />
  </ItemGroup>

  <Target Name="CheckMediaInfoDll" BeforeTargets="Build">
    <GetFileHash Files="$(PkgMediaInfoDLL)\lib\netstandard2.1\x64\MediaInfo.dll" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="MediaInfoDllHash" />
    </GetFileHash>
    <Error Condition="'$(MediaInfoDllHash)' != '35E040DDBC0BBEC2495AF938C084D98A3418F5928569EBD4C50237BC2CA98EEB'" Text="MediaInfo.dll is not MediaArea's 26.01 x64 build (SHA-256 $(MediaInfoDllHash))." />
  </Target>
</Project>
